{
  "name": "longroad-activity",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The Long Road — a Pathfinder Jade Regent expedition game, packaged as a Discord Activity.",
  "scripts": {
    "dev": "concurrently -n vite,server -c cyan,magenta \"vite\" \"node server/server.js\"",
    "dev:client": "vite",
    "dev:server": "node server/server.js",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/server.js"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^5.4.11"
  }
}
